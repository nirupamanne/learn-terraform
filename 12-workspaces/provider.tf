terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "6.70.0"
    }
  }

  backend "s3" {
    #bucket       = "remote-tf-state-92s"
    bucket       =  "nirupa-terraform-remote-state-2026"
    key          = "workspaces.tfstate"
    region       = "us-east-1"
    encrypt      = true
    use_lockfile = true
  }
}

provider "aws" {
  region = "us-east-1"
}